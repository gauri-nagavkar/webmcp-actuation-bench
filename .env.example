# Copy this file to .env and fill in ONE of the following API keys.
# The harness auto-detects the provider based on which key is present
# (or set MODEL_PROVIDER explicitly to "anthropic" or "openai").

# ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides:
MODEL_PROVIDER=openai
# ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o
# BENCH_BASE_URL=http://localhost:8842
